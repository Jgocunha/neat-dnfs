@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
# The same packages, in the same order, as neat-dnfs's CMakeLists.txt finds them. The
# exported targets name theirs, and neither imgui-platform-kit's nor
# dynamic-neural-field-composer's own package config finds what their targets need.
find_dependency(imgui CONFIG)
find_dependency(implot CONFIG)
find_dependency(unofficial-imgui-node-editor CONFIG)
find_dependency(nlohmann_json CONFIG)
if(NOT WIN32)
    find_dependency(OpenGL)
endif()
find_dependency(imgui-platform-kit)
find_dependency(FFTW3 CONFIG)
find_dependency(dynamic-neural-field-composer)

include("${CMAKE_CURRENT_LIST_DIR}/neat-dnfs-targets.cmake")

check_required_components(neat-dnfs)
